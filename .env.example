# Local application defaults. Railway supplies PORT automatically.
NODE_ENV=development
PORT=8799
DATABASE_PATH=./data/pooklet.db
PUBLIC_BASE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Use mock for offline local development. Production requires razorpay.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Independent secret entered in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
# Optional extra binding for Razorpay webhook account_id.
RAZORPAY_ACCOUNT_ID=

# Generate independently, for example: openssl rand -hex 32
INVITATION_SECRET=replace-with-at-least-32-random-characters

# One Railway process should use polling. Rotate tokens exposed in chat/logs.
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=replace-with-a-fresh-botfather-token
# Required only when TELEGRAM_MODE=webhook.
TELEGRAM_WEBHOOK_SECRET=
